{:server {:port 8080
          :host "0.0.0.0"}

 ;; Plurama itself: top-level config for the always-on umbrella.
 :db {:type :sqlite-on-disk
      :path "/app/data/plurama.db"}
 :agent {:tracker        {:base-url "https://tracker.eighttrigrams.net"
                          :skill   "/app/skills/tracker-api.md"}
         :tracker-direct {:base-url "https://tracker.eighttrigrams.net"}}
 :mail {:enabled? true
        :config-path "/app/mail.yaml"
        :poll {:every-minutes 5 :start-minute 1}
        :tracker-base-url "https://tracker.eighttrigrams.net"}
 :logging {:level :info}

 :hosts {"personalist.org"            :personalist
         "www.personalist.org"        :personalist
         "eighttrigrams.net"          :blog
         "www.eighttrigrams.net"      :blog
         "tracker.eighttrigrams.net"  :tracker
         "treina.eighttrigrams.net"   :treina
         "music.eighttrigrams.net"    :music}

 :apps {:personalist {:db {:type :sqlite-on-disk
                           :path "/app/data/personalist.db"}
                      :logging {:level :info}}

        :blog {:db {:type :sqlite-file
                    :path "/app/data/blog.db"}
               :image-base-url "https://daniel-de-oliveira.com"}

        :tracker {:db {:type :sqlite-file
                       :path "/app/data/tracker.db"}
                  :workers? true}

        :treina {:db {:type :sqlite-file
                      :path "/app/data/treina.db"}}

        :music {:db {:type :sqlite-file
                     :path "/app/data/music.db"}}}}
