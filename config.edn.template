{:server {:port #long #or [#env PORT 3100]
          :host "127.0.0.1"}

 ;; Plurama itself: the umbrella server is always running, so its db,
 ;; agent, and mail config live at the top level (not nested under :apps,
 ;; which is reserved for the embedded child apps).
 :db {:type :sqlite-on-disk
      :path "data/plurama.db"}
 :agent {:tracker        {:base-url "http://127.0.0.1:3027"
                          :skill   "../claude-stuff/plugins/tracker/skills/tracker-api/SKILL.md"}
         ;; tracker-direct is a separate tracker user, used for the
         ;; T/TT/N Telegram prefix shortcuts that bypass the AI agent.
         ;; The tracker-side user only needs message-write permissions.
         ;; No :skill — the AI agent should not see this app at all.
         :tracker-direct {:base-url "http://127.0.0.1:3027"}}
 ;; :mail only runs in prod-mode (see plurama.server). Set :enabled? true
 ;; in config.prod.edn; mail.yaml holds the per-user IMAP credentials and
 ;; is gitignored.
 :mail {:enabled? false
        :config-path "mail.yaml"
        :poll {:every-minutes 5 :start-minute 1}
        :tracker-base-url "http://127.0.0.1:3027"}

 ;; Host -> embedded app routing. Unmatched hosts fall through to the
 ;; plurama handler (the umbrella's own landing page / agent endpoints).
 :hosts {"personalist.localhost" :personalist
         "personalist.org"       :personalist
         "blog.localhost"        :blog
         "eighttrigrams.net"     :blog}

 :apps {:personalist {:db {:type :sqlite-on-disk
                           :path "../personalist/data/personalist.db"}
                      :devel {:pre-seed? false
                              :shadow? true
                              :dangerously-skip-logins? false}
                      :logging {:file "logs/personalist.log"
                                :level :debug
                                :format :human}}

        :blog {:db {:type :sqlite-file
                    :path "../blog/data/blog.db"}
               :image-base-url "https://daniel-de-oliveira.com"}}}
